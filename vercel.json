{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/website/index.html"
    },
    {
      "source": "/tos",
      "destination": "/website/tos.html"
    },
    {
      "source": "/privacy",
      "destination": "/website/privacy.html"
    },
    {
      "source": "/css/(.*)",
      "destination": "/website/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/website/js/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/website/$1"
    }
  ]
}
